DATABASE_URL="file:../data/blog.db"
# Optional runtime override. Relative paths use main/ as their base.
# DATABASE_PATH="data/blog.db"
SESSION_SECRET="replace-with-at-least-32-random-characters"
FINGERPRINT_SECRET=""
# 生产环境的对外地址，给 sitemap / RSS / Open Graph 用。也可在后台「设置」里填。
# SITE_URL="https://example.com"
# 管理员账号与备份口令只走 /admin/setup 或 pnpm setup，不要写进本文件。
