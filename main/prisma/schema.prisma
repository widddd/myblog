// MyBlog 数据模型 — 字段说明见 docs/data-models.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Post {
  id           Int          @id @default(autoincrement())
  publicId     String       @unique
  slug         String       @unique
  title        String
  // 文章作者（笔名）。为空 = 用管理员账号上的默认笔名（见 lib/posts/author.ts）
  authorName   String?
  content      String
  excerpt      String?
  cover        String?
  // 列表卡封面自己的形态：image | solid | gradient | none。
  // 与 bannerStyle 解耦，互不覆盖。
  coverStyle   String       @default("image")
  coverColor   String?
  coverColor2  String?
  bannerStyle  String       @default("cover") // cover（与封面一致） | image | solid | gradient
  bannerImage  String?
  bannerColor  String?
  bannerColor2 String?
  // 封面图在列表卡片里的焦点（0–100，百分比）；50/50 = 居中。
  coverFocalX  Int          @default(50)
  coverFocalY  Int          @default(50)
  // 封面图在文章详情 Banner 里的焦点；与卡片分开，允许同一张图各裁各的重点。
  bannerFocalX Int          @default(50)
  bannerFocalY Int          @default(50)
  passwordHash String?
  status       String       @default("draft") // draft | scheduled | published
  publishedAt  DateTime?
  pinned       Boolean      @default(false)
  recommend    Boolean      @default(false)
  views        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  // 作者在**文章已发布之后**再次改动正文/标题等实质内容的时间。
  // 不能用 updatedAt 顶替：浏览量自增、定时发布、publicId 回填都会把 updatedAt 刷成"现在"（见 P-087）。
  revisedAt    DateTime?
  // 文章页是否显示「已修改 + 修改时间」，编辑页设置栏可关。
  showRevisedAt Boolean     @default(true)
  categoryId   Int?
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags         PostTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

model Category {
  id    Int       @id @default(autoincrement())
  slug  String    @unique
  name  String
  posts Post[]
}

model Tag {
  id    Int       @id @default(autoincrement())
  slug  String    @unique
  name  String
  posts PostTag[]
}

model PostTag {
  postId Int
  tagId  Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model Moment {
  id        Int          @id @default(autoincrement())
  content   String      
  images    String       @default("[]") // JSON: [{key, thumb, width, height}]
  createdAt DateTime     @default(now())
  // 可见范围组：为空 = 跟随「全局可见期」；有值 = 用该组的天数。
  // 最终对外可见天数 = min(全局可见期, 组天数)，任一侧 0 视为不限制（见 lib/moments/visibility.ts）。
  visibilityGroupId Int?
  visibilityGroup   MomentVisibilityGroup? @relation(fields: [visibilityGroupId], references: [id], onDelete: SetNull)
  likes     MomentLike[]

  @@index([visibilityGroupId])
}

model MomentLike {
  id          Int     @id @default(autoincrement())
  momentId    Int
  fingerprint String
  moment      Moment  @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@unique([momentId, fingerprint])
}

// 瞬间可见范围组（3 天可见组 / 7 天可见组 / 1 个月可见组…）：发布瞬间时可选，后台可增删改。
// 删除组不会删瞬间：外键 SetNull，这些瞬间回落到「全局可见期」。
model MomentVisibilityGroup {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  days      Int // 发布后对外可见的天数，1–MAX_MOMENT_VISIBILITY_DAYS
  createdAt DateTime @default(now())
  moments   Moment[]
}

// 静态页面：管理员自定义的独立页面，挂在 Setting `staticPagesDir` 指定的目录下，
// 前台地址 = /{staticPagesDir}/{slug}。目录名与地址段都必须是单段 URL 安全字符，
// 且不得占用保留段（见 lib/pages/static-page.ts）；前台路由是 Next 里优先级最低的
// 动态段，框架路由与本站自有路由永远优先。
model StaticPage {
  id          Int      @id @default(autoincrement())
  // 地址最后一段，全库唯一（目录是单值，所以 slug 唯一就等于地址唯一）
  slug        String   @unique
  title       String
  description String   @default("") // meta description / 索引页副标题
  html        String   @default("")
  css         String   @default("")
  js          String   @default("")
  enabled     Boolean  @default(true) // 关掉即前台 404，页面内容保留
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// SQLite 不支持 Prisma enum，用字符串常量约束（见 docs/data-models.md）
model Comment {
  id         Int     @id @default(autoincrement())
  targetType String // post | moment | board
  targetId   Int     @default(0) // board 时固定 0
  nickname   String
  email      String?
  content    String 
  parentId   Int?
  parent     Comment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentThread")
  status     String  @default("pending") // pending | approved
  isAdmin    Boolean @default(false)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, status])
  @@index([parentId])
}

model Setting {
  key   String @id
  value String
}

model AdminUser {
  id                     Int      @id @default(autoincrement())
  username               String   @unique
  // 默认笔名：新文章的作者默认取它，文章没单独填作者时前台也显示它
  penName                String?
  passwordHash           String
  mustChangeCredentials  Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// 笔名清单（像分类/标签一样可加多个）：写文章时下拉快捷选，也能当场新建
model PenName {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model BackupSecret {
  name      String   @id
  keyHash   String
  algo      String   @default("aes-256-gcm")
  createdAt DateTime @default(now())
}

model Upload {
  id        Int      @id @default(autoincrement())
  hash      String   @unique
  driver    String   @default("local") // local | cos（历史值 oss 当 cos）
  key       String // posix style relative path
  mime      String
  width     Int?
  height    Int?
  size      Int
  variants  String   @default("{}") // JSON: {thumb, thumb2, content}
  createdAt DateTime @default(now())
  // 相册归属：**单归属**，为空 = 未分类（见 docs/albums-spec.md D2）。
  // 相册只收图片（image/*）；视频/音频不参与相册。
  albumId   Int?
  album     Album?   @relation("AlbumUploads", fields: [albumId], references: [id], onDelete: SetNull)
  // 卷归属：相册内的一"卷"（一次拍摄 / 一组照片），为空 = 本相册里「未分类」，照样展示。
  // 不变量：volume.albumId 必须等于 albumId（写入层守，见 lib/albums/admin.ts）。
  // 删卷只解绑（SetNull），照片留在相册里变成未分类。
  volumeId  Int?
  volume    AlbumVolume? @relation("VolumeUploads", fields: [volumeId], references: [id], onDelete: SetNull)
  // 被哪些相册选作了封面（删媒体时封面自动置空，相册回落到第一张图）
  coverOf   Album[]  @relation("AlbumCover")

  @@index([albumId])
  @@index([volumeId])
}

// 相册：对外公开的独立页面 /albums/{slug}（见 docs/albums-spec.md）。
// 照片按「上传时间倒序」排在相册里，顺序字段留到版式定稿后再说。
model Album {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String   @default("")
  // 封面：手动选本相册里的一张；为空则用第一张
  coverId     Int?
  cover       Upload?  @relation("AlbumCover", fields: [coverId], references: [id], onDelete: SetNull)
  // 关掉：相册列表里不出现、详情页 404、文章灯箱的「查看相册」按钮也不出现
  enabled     Boolean  @default(true)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  uploads     Upload[] @relation("AlbumUploads")
  // 卷（一次拍摄 / 一组照片）：详情页按卷展示，每卷是一叠可展开的照片
  volumes     AlbumVolume[] @relation("AlbumVolumes")
}

// 相册里的一"卷"：详情页按卷展示、每卷一叠可展开（版式定稿见 demo/album-page）。
// 卷只有标题 + 排序，**没有日期字段**——组头显示的日期由本卷照片的上传时间实时算（不存冗余）。
model AlbumVolume {
  id        Int      @id @default(autoincrement())
  albumId   Int
  album     Album    @relation("AlbumVolumes", fields: [albumId], references: [id], onDelete: Cascade)
  title     String   @default("")
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  uploads   Upload[] @relation("VolumeUploads")

  @@index([albumId, sort])
}

// 首页模块目录：内置模块 + 管理员自建模块（见 docs/home-modules-spec.md）
model HomeModule {
  id         Int            @id @default(autoincrement())
  slug       String         @unique
  name       String
  kind       String         @default("builtin") // builtin | custom
  builtinKey String? // banner | welcome | recommend | moments | posts | announcement | site | categories | tags | recent | uptime
  html       String         @default("")
  css        String         @default("")
  js         String         @default("")
  blocks     String         @default("[]") // JSON: HomeBlock[]
  config     String         @default("{}") // JSON: 模块实例配置
  system     Boolean        @default(false) // 内置模块不可删除，只能关闭
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  placement  HomePlacement?
}

// 首页格点：电脑/手机两套几何，rowSpan 恒为 1
model HomePlacement {
  id             Int        @id @default(autoincrement())
  moduleId       Int        @unique
  module         HomeModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  enabled        Boolean    @default(true)
  col            Int        @default(1)
  colSpan        Int        @default(12)
  row            Int        @default(1)
  rowSpan        Int        @default(1)
  hPct           Int        @default(0)
  mobileCol      Int        @default(1)
  mobileColSpan  Int        @default(12)
  mobileRow      Int        @default(1)
  mobileHPct     Int        @default(0)
  sort           Int        @default(0)

  @@index([row, col])
}
