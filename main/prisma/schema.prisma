// MyBlog 数据模型 — 字段说明见 docs/data-models.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Post {
  id           Int          @id @default(autoincrement())
  publicId     String       @unique
  slug         String       @unique
  title        String
  content      String
  excerpt      String?
  cover        String?
  bannerStyle  String       @default("cover") // cover | solid | gradient
  bannerColor  String?
  bannerColor2 String?
  passwordHash String?
  status       String       @default("draft") // draft | scheduled | published
  publishedAt  DateTime?
  pinned       Boolean      @default(false)
  recommend    Boolean      @default(false)
  views        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  categoryId   Int?
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags         PostTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
}

model Category {
  id    Int       @id @default(autoincrement())
  slug  String    @unique
  name  String
  posts Post[]
}

model Tag {
  id    Int       @id @default(autoincrement())
  slug  String    @unique
  name  String
  posts PostTag[]
}

model PostTag {
  postId Int
  tagId  Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model Moment {
  id        Int          @id @default(autoincrement())
  content   String      
  images    String       @default("[]") // JSON: [{key, thumb, width, height}]
  createdAt DateTime     @default(now())
  likes     MomentLike[]
}

model MomentLike {
  id          Int     @id @default(autoincrement())
  momentId    Int
  fingerprint String
  moment      Moment  @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@unique([momentId, fingerprint])
}

// SQLite 不支持 Prisma enum，用字符串常量约束（见 docs/data-models.md）
model Comment {
  id         Int     @id @default(autoincrement())
  targetType String // post | moment | board
  targetId   Int     @default(0) // board 时固定 0
  nickname   String
  email      String?
  content    String 
  parentId   Int?
  parent     Comment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentThread")
  status     String  @default("pending") // pending | approved
  isAdmin    Boolean @default(false)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, status])
  @@index([parentId])
}

model Setting {
  key   String @id
  value String
}

model AdminUser {
  id                     Int      @id @default(autoincrement())
  username               String   @unique
  passwordHash           String
  mustChangeCredentials  Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model BackupSecret {
  name      String   @id
  keyHash   String
  algo      String   @default("aes-256-gcm")
  createdAt DateTime @default(now())
}

model Upload {
  id        Int      @id @default(autoincrement())
  hash      String   @unique
  driver    String   @default("local") // local | cos（历史值 oss 当 cos）
  key       String // posix style relative path
  mime      String
  width     Int?
  height    Int?
  size      Int
  variants  String   @default("{}") // JSON: {thumb, thumb2, content}
  createdAt DateTime @default(now())
}

// 首页模块目录：内置模块 + 管理员自建模块（见 docs/home-modules-spec.md）
model HomeModule {
  id         Int            @id @default(autoincrement())
  slug       String         @unique
  name       String
  kind       String         @default("builtin") // builtin | custom
  builtinKey String? // banner | welcome | recommend | moments | posts | announcement | site | categories | tags | recent | uptime
  html       String         @default("")
  css        String         @default("")
  js         String         @default("")
  blocks     String         @default("[]") // JSON: HomeBlock[]
  config     String         @default("{}") // JSON: 模块实例配置
  system     Boolean        @default(false) // 内置模块不可删除，只能关闭
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  placement  HomePlacement?
}

// 首页格点：电脑/手机两套几何，rowSpan 恒为 1
model HomePlacement {
  id             Int        @id @default(autoincrement())
  moduleId       Int        @unique
  module         HomeModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  enabled        Boolean    @default(true)
  col            Int        @default(1)
  colSpan        Int        @default(12)
  row            Int        @default(1)
  rowSpan        Int        @default(1)
  hPct           Int        @default(0)
  mobileCol      Int        @default(1)
  mobileColSpan  Int        @default(12)
  mobileRow      Int        @default(1)
  mobileHPct     Int        @default(0)
  sort           Int        @default(0)

  @@index([row, col])
}
